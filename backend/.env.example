PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pawpoint
JWT_SECRET=

# Optional: comma-separated DNS resolvers. Node's bundled c-ares can default to
# 127.0.0.1 on DHCP-configured Windows machines, which breaks Atlas SRV lookups.
DNS_SERVERS=192.168.1.1

# Optional: accounts registering with this email are granted admin rights, which
# unlocks doctor create/update/delete. Leave blank and every user is a regular
# account. Development convenience only - anyone able to register this address
# becomes an admin, so a deployed environment needs an invite or approval flow.
ADMIN_EMAIL=